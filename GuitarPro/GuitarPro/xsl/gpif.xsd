<?xml version="1.0" encoding="utf-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema">

  <!-- basic types -->
  <xsd:simpleType name="ubyteType">
    <xsd:restriction base="xsd:unsignedInt">
      <xsd:maxInclusive value="255" />
    </xsd:restriction>
  </xsd:simpleType>

  <xsd:simpleType name="stringType">
    <xsd:restriction base="xsd:unsignedInt">
      <xsd:maxInclusive value="8" />
    </xsd:restriction>
  </xsd:simpleType>
  
  <xsd:simpleType name="fretType">
    <xsd:restriction base="xsd:unsignedInt">
      <xsd:maxInclusive value="36" />
    </xsd:restriction>
  </xsd:simpleType>

  <xsd:simpleType name="voiceIndexType">
    <xsd:restriction base="xsd:integer">
      <xsd:minInclusive value="-1" />
    </xsd:restriction>
  </xsd:simpleType>

  <xsd:simpleType name="timeUnitType">
    <xsd:restriction base="xsd:string">
      <xsd:pattern value="[0-9]+/[0-9]+" />
    </xsd:restriction>
  </xsd:simpleType>

  <xsd:simpleType name="keyAccidentalType">
    <xsd:restriction base="xsd:integer">
      <xsd:minInclusive value="-7" />
      <xsd:maxInclusive value="7" />
    </xsd:restriction>
  </xsd:simpleType>

  <!-- basic list types -->
  <xsd:simpleType name="ubyteListType">
    <xsd:list itemType="ubyteType" />
  </xsd:simpleType>

  <xsd:simpleType name="intListType">
    <xsd:list itemType="xsd:integer" />
  </xsd:simpleType>

  <xsd:simpleType name="uintListType">
    <xsd:list itemType="xsd:unsignedInt" />
  </xsd:simpleType>

  <xsd:simpleType name="floatListType">
    <xsd:list itemType="xsd:float" />
  </xsd:simpleType>

  <!-- advanced list types -->
  <xsd:simpleType name="nonEmptyUintListType">
    <xsd:restriction base="uintListType">
      <xsd:minLength value="1" />
    </xsd:restriction>
  </xsd:simpleType>

  <xsd:simpleType name="tuningType">
    <xsd:restriction>
      <xsd:simpleType>
        <xsd:list itemType="ubyteType" />
      </xsd:simpleType>
      <xsd:minLength value="1" />
      <xsd:maxLength value="8" />
    </xsd:restriction>
  </xsd:simpleType>
  
  <xsd:simpleType name="voiceListType">
    <xsd:restriction>
      <xsd:simpleType>
        <xsd:list itemType="voiceIndexType" />
      </xsd:simpleType>
      <xsd:minLength value="4" />
      <xsd:maxLength value="4" />
    </xsd:restriction>
  </xsd:simpleType>

  <xsd:simpleType name="colorType">
    <xsd:restriction base="ubyteListType">
      <xsd:minLength value="3" />
      <xsd:maxLength value="3" />
    </xsd:restriction>
  </xsd:simpleType>

  <xsd:simpleType name="pointType">
    <xsd:restriction>
      <xsd:simpleType>
        <xsd:list itemType="xsd:integer" />
      </xsd:simpleType>
      <xsd:minLength value="3" />
      <xsd:maxLength value="3" />
    </xsd:restriction>
  </xsd:simpleType>

  <!-- enumerations -->
  <xsd:simpleType name="clefType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="C" />
      <xsd:enumeration value="F" />
      <xsd:enumeration value="G" />
      <xsd:enumeration value="Neutral" />
    </xsd:restriction>
  </xsd:simpleType>

  <xsd:simpleType name="playingStyleType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="Default" />
      <xsd:enumeration value="StringedPick" />
      <xsd:enumeration value="StringedFinger" />
      <xsd:enumeration value="StringedFingerPicking" />
      <xsd:enumeration value="BassSlap" />
      <xsd:enumeration value="DrumKitBrush" />
      <xsd:enumeration value="DrumKitHotRod" />
      <xsd:enumeration value="DrumKitStick" />
    </xsd:restriction>
  </xsd:simpleType>

  <xsd:simpleType name="playbackStateType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="Default" />
      <xsd:enumeration value="Solo" />
      <xsd:enumeration value="Mute" />
    </xsd:restriction>
  </xsd:simpleType>

  <xsd:simpleType name="keyModeType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="Major" />
      <xsd:enumeration value="Minor" />
    </xsd:restriction>
  </xsd:simpleType>

  <xsd:simpleType name="ottaviaType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="8va" />
      <xsd:enumeration value="8vb" />
      <xsd:enumeration value="15ma" />
      <xsd:enumeration value="15mb" />
    </xsd:restriction>
  </xsd:simpleType>

  <xsd:simpleType name="dynamicType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="None" />
      <xsd:enumeration value="PPPPPPP" />
      <xsd:enumeration value="PPPPPP" />
      <xsd:enumeration value="PPPPP" />
      <xsd:enumeration value="PPPP" />
      <xsd:enumeration value="PPP" />
      <xsd:enumeration value="PP" />
      <xsd:enumeration value="P" />
      <xsd:enumeration value="MP" />
      <xsd:enumeration value="MF" />
      <xsd:enumeration value="F" />
      <xsd:enumeration value="FF" />
      <xsd:enumeration value="FFF" />
      <xsd:enumeration value="FFFF" />
      <xsd:enumeration value="FFFFF" />
      <xsd:enumeration value="FFFFFF" />
      <xsd:enumeration value="FFFFFFF" />
    </xsd:restriction>
  </xsd:simpleType>

  <xsd:simpleType name="accentuationType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="Ghost" />
      <xsd:enumeration value="Normal" />
      <xsd:enumeration value="Heavy" />
    </xsd:restriction>
  </xsd:simpleType>

  <xsd:simpleType name="fingeringType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="None" />
      <xsd:enumeration value="P" />
      <xsd:enumeration value="I" />
      <xsd:enumeration value="M" />
      <xsd:enumeration value="A" />
      <xsd:enumeration value="C" />
    </xsd:restriction>
  </xsd:simpleType>

  <xsd:simpleType name="graceNoteTransitionType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="None" />
      <xsd:enumeration value="Slide" />
      <xsd:enumeration value="Bend" />
      <xsd:enumeration value="Hammer" />
    </xsd:restriction>
  </xsd:simpleType>

  <xsd:simpleType name="noteValueType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="Long" />
      <xsd:enumeration value="DoubleWhole" />
      <xsd:enumeration value="Whole" />
      <xsd:enumeration value="Half" />
      <xsd:enumeration value="Quarter" />
      <xsd:enumeration value="Eighth" />
      <xsd:enumeration value="16th" />
      <xsd:enumeration value="32nd" />
      <xsd:enumeration value="64th" />
      <xsd:enumeration value="128th" />
      <xsd:enumeration value="256th" />
    </xsd:restriction>
  </xsd:simpleType>

  <xsd:simpleType name="directionTargetType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="Coda" />
      <xsd:enumeration value="DoubleCoda" />
      <xsd:enumeration value="Segno" />
      <xsd:enumeration value="SegnoSegno" />
      <xsd:enumeration value="Fine" />
    </xsd:restriction>
  </xsd:simpleType>

  <xsd:simpleType name="directionJumpType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="DaCapo" />
      <xsd:enumeration value="DaCapoAlCoda" />
      <xsd:enumeration value="DaCapoAlDoubleCoda" />
      <xsd:enumeration value="DaCapoAlFine" />
      <xsd:enumeration value="DaSegno" />
      <xsd:enumeration value="DaSegnoAlCoda" />
      <xsd:enumeration value="DaSegnoAlDoubleCoda" />
      <xsd:enumeration value="DaSegnoAlFine" />
      <xsd:enumeration value="DaSegnoSegno" />
      <xsd:enumeration value="DaSegnoSegnoAlCoda" />
      <xsd:enumeration value="DaSegnoSegnoAlDoubleCoda" />
      <xsd:enumeration value="DaSegnoSegnoAlFine" />
      <xsd:enumeration value="DaCoda" />
      <xsd:enumeration value="DaDoubleCoda" />
    </xsd:restriction>
  </xsd:simpleType>

  <xsd:simpleType name="bendTypeType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="None" />
      <xsd:enumeration value="Bend" />
      <xsd:enumeration value="BendRelease" />
      <xsd:enumeration value="BendReleaseBend" />
      <xsd:enumeration value="PreBend" />
      <xsd:enumeration value="PreBendRelease" />
    </xsd:restriction>
  </xsd:simpleType>

  <xsd:simpleType name="whammyBarTypeType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="None" />
      <xsd:enumeration value="Dip" />
      <xsd:enumeration value="Dive" />
      <xsd:enumeration value="ReleaseUp" />
      <xsd:enumeration value="Inverted" />
      <xsd:enumeration value="Return" />
      <xsd:enumeration value="ReleaseDown" />
    </xsd:restriction>
  </xsd:simpleType>

  <xsd:simpleType name="strokeDirectionType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="Up" />
      <xsd:enumeration value="Down" />
    </xsd:restriction>
  </xsd:simpleType>

  <xsd:simpleType name="vibratoType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="Slight" />
      <xsd:enumeration value="Wide" />
    </xsd:restriction>
  </xsd:simpleType>

  <xsd:simpleType name="wahType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="Closed" />
      <xsd:enumeration value="Open" />
    </xsd:restriction>
  </xsd:simpleType>

  <xsd:simpleType name="legatoType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="Intermediate" />
      <xsd:enumeration value="Complete" />
    </xsd:restriction>
  </xsd:simpleType>

  <xsd:simpleType name="harmonicTypeType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="Natural" />
      <xsd:enumeration value="Artificial" />
      <xsd:enumeration value="Pinch" />
      <xsd:enumeration value="Tap" />
      <xsd:enumeration value="Semi" />
    </xsd:restriction>
  </xsd:simpleType>

  <xsd:simpleType name="harmonicFretType">
    <xsd:restriction base="xsd:float">
      <xsd:maxInclusive value="36" />
    </xsd:restriction>
  </xsd:simpleType>

  <xsd:simpleType name="slotIdType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="Kick_00" />
      <xsd:enumeration value="Snare_00" />
      <xsd:enumeration value="Tom_00" />
      <xsd:enumeration value="Tom_01" />
      <xsd:enumeration value="Tom_02" />
      <xsd:enumeration value="Tom_03" />
      <xsd:enumeration value="Tom_04" />
      <xsd:enumeration value="Hihat_00" />
      <xsd:enumeration value="Crash_00" />
      <xsd:enumeration value="Crash_01" />
      <xsd:enumeration value="Splash_00" />
      <xsd:enumeration value="Ride_00" />
      <xsd:enumeration value="China_00" />
      <xsd:enumeration value="CowBell_00" />
      <xsd:enumeration value="CowBell_01" />
      <xsd:enumeration value="CowBell_03" />
    </xsd:restriction>
  </xsd:simpleType>

  <xsd:simpleType name="beaterType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="Stick" />
      <xsd:enumeration value="HotRod" />
      <xsd:enumeration value="Mallet" />
      <xsd:enumeration value="Brush" />
      <xsd:enumeration value="Pedal" />
      <xsd:enumeration value="Hand" />
    </xsd:restriction>
  </xsd:simpleType>

  <xsd:simpleType name="beaterTechnicType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="Hit" />
      <xsd:enumeration value="Drag" />
      <xsd:enumeration value="Flam" />
      <xsd:enumeration value="RimShot" />
      <xsd:enumeration value="SideStick" />
    </xsd:restriction>
  </xsd:simpleType>

  <xsd:simpleType name="hihatOpeningType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="FullOpen" />
      <xsd:enumeration value="HalfOpen" />
      <xsd:enumeration value="Closed" />
    </xsd:restriction>
  </xsd:simpleType>

  <xsd:simpleType name="ridePartType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="Middle" />
      <xsd:enumeration value="Edge" />
      <xsd:enumeration value="Bell" />
    </xsd:restriction>
  </xsd:simpleType>
  
  <xsd:simpleType name="tripletFeelType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="NoTripletFeel" />
      <xsd:enumeration value="Triplet8th" />
      <xsd:enumeration value="Triplet16th" />
      <xsd:enumeration value="Dotted8th" />
      <xsd:enumeration value="Dotted16th" />
      <xsd:enumeration value="Scottish8th" />
      <xsd:enumeration value="Scottish16th" />
    </xsd:restriction>
  </xsd:simpleType>

  <xsd:simpleType name="effectRailType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="FirstRail" />
      <xsd:enumeration value="MiddleTopRail" />
      <xsd:enumeration value="MiddleBottomRail" />
      <xsd:enumeration value="LastRail" />
    </xsd:restriction>
  </xsd:simpleType>

  <xsd:simpleType name="instrumentRefType">
