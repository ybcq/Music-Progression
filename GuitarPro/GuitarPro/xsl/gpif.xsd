  <xsd:simpleType name="gmTableType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="Instrument" />
      <xsd:enumeration value="Percussion" />
    </xsd:restriction>
  </xsd:simpleType>

  <xsd:simpleType name="simileMarkType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="Simple" />
      <xsd:enumeration value="Double" />
    </xsd:restriction>
  </xsd:simpleType>

  <xsd:simpleType name="graceNotesType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="OnBeat" />
      <xsd:enumeration value="BeforeBeat" />
    </xsd:restriction>
  </xsd:simpleType>
    
  <xsd:simpleType name="fermataTypeType">
    <xsd:restriction base="xsd:string">
        <xsd:enumeration value="Short" />
        <xsd:enumeration value="Medium" />
        <xsd:enumeration value="Long" />
    </xsd:restriction>
  </xsd:simpleType>
  
  <!-- complex types -->
  
  <xsd:complexType name="fermataType">
    <xsd:all>
        <xsd:element name="Type"   type="fermataTypeType" minOccurs="1" />
        <xsd:element name="Offset" type="timeUnitType"    minOccurs="1" />
        <xsd:element name="Length" type="xsd:float"       minOccurs="1" />
    </xsd:all>
  </xsd:complexType>
  
  <xsd:complexType name="fermataListType">
    <xsd:sequence minOccurs="0" maxOccurs="unbounded">
        <xsd:element name="Fermata" type="fermataType" /> 
    </xsd:sequence>
  </xsd:complexType>
  
  <xsd:complexType name="bendType">
    <xsd:all>
      <xsd:element name="Type" type="bendTypeType" minOccurs="1" />
      <xsd:element name="Value" type="xsd:unsignedInt" minOccurs="1" />
      <xsd:element name="Points" minOccurs="0">
        <xsd:complexType>
          <xsd:sequence minOccurs="0" maxOccurs="unbounded">
            <xsd:element name="Point" type="pointType" />
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
    </xsd:all>
  </xsd:complexType>

  <xsd:complexType name="whammyBarType">
    <xsd:all>
      <xsd:element name="Type" type="whammyBarTypeType" minOccurs="1" />
      <xsd:element name="Value" type="xsd:unsignedInt" minOccurs="1" />
      <xsd:element name="Points" minOccurs="0">
        <xsd:complexType>
          <xsd:sequence minOccurs="0" maxOccurs="unbounded">
            <xsd:element name="Point" type="pointType" />
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
    </xsd:all>
  </xsd:complexType>

  <xsd:complexType name="brushType">
    <xsd:all>
      <xsd:element name="Direction" type="strokeDirectionType" minOccurs="1" />
      <xsd:element name="Speed"     type="timeUnitType"        minOccurs="1" />
    </xsd:all>
  </xsd:complexType>
  
  <xsd:complexType name="automationType">
    <xsd:all>
      <xsd:element name="Offset" type="timeUnitType" minOccurs="1" />
      <xsd:element name="Length" type="timeUnitType" minOccurs="1" />
      <xsd:element name="Value" type="xsd:integer" minOccurs="1" />
    </xsd:all>
  </xsd:complexType>

  <xsd:complexType name="chordCollectionType" >
    <xsd:sequence>
      <xsd:element name="Chord" minOccurs="0" maxOccurs="unbounded">
        <xsd:complexType>
          <xsd:attribute name="name" type="xsd:string" use="required" />
          <xsd:attribute name="baseFret" type="xsd:unsignedInt" use="required" />
          <xsd:attribute name="spanLimit" type="xsd:unsignedInt" use="required" />
          <xsd:attribute name="barsStates" type="uintListType" use="required" />
          <xsd:attribute name="frets" type="intListType" use="required" />
        </xsd:complexType>
      </xsd:element>
    </xsd:sequence>
  </xsd:complexType>

  <!-- properties -->
  <xsd:complexType name="propertyListType">
    <xsd:sequence minOccurs="0" maxOccurs="unbounded">
      <xsd:element name="Property">
        <xsd:complexType>
          <xsd:sequence minOccurs="0" maxOccurs="1">
            <xsd:choice>
              <!-- Tuning -->
              <xsd:element name="Pitches" type="tuningType"/>
              <!-- Fret, Capo -->
              <xsd:element name="Fret" type="fretType" />
              <!-- ChorCollection -->
              <xsd:element name="Chords" type="chordCollectionType" />
              <!-- Slapped, Popped, Dead, PalmMuted, Tapped, Choked -->
              <xsd:element name="Enable" />
              <!-- PickStroked -->
              <xsd:element name="Direction" type="strokeDirectionType" />
              <!-- Brush -->
              <xsd:element name="BrushDescription" type="brushType" />
              <!-- VibratoWTremBar, Vibrato-->
              <xsd:element name="Strength" type="vibratoType" />
              <!-- WhammyBar -->
              <xsd:element name="WhammyBarDescription" type="whammyBarType" />
              <!-- WahWah -->
              <xsd:element name="WahType" type="wahType" />
              <!-- Chord -->
              <xsd:element name="Name" type="xsd:string" />
              <!-- String -->
              <xsd:element name="String" type="stringType" />
              <!-- Bend -->
              <xsd:element name="BendDescription" type="bendType" />
              <!-- Slide -->
              <xsd:element name="Flags" type="ubyteType" />
              <!-- HarmonicType -->
              <xsd:element name="HType" type="harmonicTypeType" />
              <!-- HarmonicFret -->
              <xsd:element name="HFret" type="harmonicFretType" />
              <!-- Tone -->
              <xsd:element name="Step" type="ubyteType" />
              <!-- Octave, Midi -->
              <xsd:element name="Number" type="ubyteType" />
              <!-- SlotId -->
              <xsd:element name="Slot" type="slotIdType" />
              <!-- Beater -->
              <xsd:element name="BeaterType" type="beaterType" />
              <!-- BeaterTechnic -->
              <xsd:element name="BeaterTechnicType" type="beaterTechnicType" />
              <!-- HiHatOpening -->
              <xsd:element name="HiHatOpeningType" type="hihatOpeningType" />
              <!-- RidePart -->
              <xsd:element name="RidePartType" type="ridePartType" />
            </xsd:choice>
          </xsd:sequence>
          <xsd:attribute name="name" type="xsd:string" use="required" />
        </xsd:complexType>
      </xsd:element>
    </xsd:sequence>
  </xsd:complexType>

  <!-- attributes -->
  <xsd:simpleType name="coreAttributeTypeType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="bool" />
      <xsd:enumeration value="int" />
      <xsd:enumeration value="float" />
      <xsd:enumeration value="string" />
    </xsd:restriction>
  </xsd:simpleType>

  <xsd:complexType name="coreAttributeListType">
    <xsd:sequence minOccurs="0" maxOccurs="unbounded">
      <xsd:element name="Attribute">
        <xsd:complexType>
          <xsd:attribute name="id" type="xsd:unsignedInt" use="required" />
          <xsd:attribute name="type" type="coreAttributeTypeType" use="required" />
          <xsd:attribute name="value" type="xsd:string" use="required" />
        </xsd:complexType>
      </xsd:element>
    </xsd:sequence>
  </xsd:complexType>

  <!-- document structure -->
  <xsd:element name="GPIF">
    <xsd:complexType>
      <xsd:all>

        <!--  Score -->
        <xsd:element name="Score" minOccurs="0" maxOccurs="1">
          <xsd:complexType>
            <xsd:all>
              <xsd:element name="Title" type="xsd:string" minOccurs="0" />
              <xsd:element name="SubTitle" type="xsd:string" minOccurs="0" />
              <xsd:element name="Artist" type="xsd:string" minOccurs="0" />
              <xsd:element name="Album" type="xsd:string" minOccurs="0" />
              <xsd:element name="Words" type="xsd:string" minOccurs="0" />
              <xsd:element name="Music" type="xsd:string" minOccurs="0" />
              <xsd:element name="Copyright" type="xsd:string" minOccurs="0" />
              <xsd:element name="Tabber" type="xsd:string" minOccurs="0" />
              <xsd:element name="Instructions" type="xsd:string" minOccurs="0" />
              <xsd:element name="FirstPageHeader" type="xsd:string" minOccurs="0" />
              <xsd:element name="FirstPageFooter" type="xsd:string" minOccurs="0" />
              <xsd:element name="PageHeader" type="xsd:string" minOccurs="0" />
              <xsd:element name="PageFooter" type="xsd:string" minOccurs="0" />
            </xsd:all>
          </xsd:complexType>
        </xsd:element>

        <!-- MasterTrack -->
        <xsd:element name="MasterTrack" minOccurs="1" maxOccurs="1">
          <xsd:complexType>
            <xsd:all>
              <xsd:element name="Tempo" type="xsd:unsignedInt" minOccurs="1" />
              <xsd:element name="TempoLabel" type="xsd:string" minOccurs="0" />
              <xsd:element name="Tracks" type="nonEmptyUintListType" minOccurs="1" />
            </xsd:all>
          </xsd:complexType>
        </xsd:element>

        <!--  Tracks -->
        <xsd:element name="Tracks" minOccurs="1" maxOccurs="1">
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element name="Track" minOccurs="1" maxOccurs="unbounded">
                <xsd:complexType>
                  <xsd:all>
                    <xsd:element name="Name" type="xsd:string" minOccurs="0" />
                    <xsd:element name="ShortName" type="xsd:string" minOccurs="0" />
                    <xsd:element name="Color" type="colorType" minOccurs="1" />
                    <xsd:element name="Clef" type="clefType" minOccurs="1" />
                    <xsd:element name="Instrument" minOccurs="0">
                      <xsd:complexType>
                        <xsd:attribute name="ref" type="instrumentRefType" use="required" />
                      </xsd:complexType>
                    </xsd:element>
                    <xsd:element name="PlayingStyle" type="playingStyleType" minOccurs="1" />
                    <xsd:element name="RSE" minOccurs="0">
                      <xsd:complexType>
                        <xsd:all>
                          <xsd:element name="Bank" type="xsd:string" minOccurs="1" />
                          <xsd:element name="EffectChains" minOccurs="0">
                            <xsd:complexType>
                              <xsd:sequence minOccurs="1" maxOccurs="unbounded">
                                <xsd:element name="EffectChain">
                                  <xsd:complexType>
                                    <xsd:sequence>
                                      <xsd:element name="Name" type="xsd:string" />
                                      <xsd:element name="Rail" maxOccurs="unbounded">
                                        <xsd:complexType>
                                          <xsd:sequence>
                                            <xsd:element name="Effect" minOccurs="0" maxOccurs="unbounded">
                                              <xsd:complexType>
                                                <xsd:all>
                                                  <xsd:element name="ByPass" minOccurs="0" />
                                                  <xsd:element name="Parameters" type="floatListType" />
                                                </xsd:all>
                                                <xsd:attribute name="id" type="xsd:string" />
                                              </xsd:complexType>
                                            </xsd:element>
                                          </xsd:sequence>
                                          <xsd:attribute name="name" type="xsd:string" />
                                        </xsd:complexType>
                                      </xsd:element>
                                    </xsd:sequence>
                                  </xsd:complexType>
                                </xsd:element>
                              </xsd:sequence>
                            </xsd:complexType>
                          </xsd:element>
                        </xsd:all>
                      </xsd:complexType>
                    </xsd:element>
                    <xsd:element name="GeneralMidi" minOccurs="1">
                      <xsd:complexType>
                        <xsd:all>
                          <xsd:element name="Program" type="ubyteType" minOccurs="1" />
                          <xsd:element name="Port" type="ubyteType" minOccurs="1" />
                          <xsd:element name="PrimaryChannel" type="ubyteType" minOccurs="1" />
                          <xsd:element name="SecondaryChannel" type="ubyteType" minOccurs="1" />
                        </xsd:all>
                        <xsd:attribute name="table" type="gmTableType" use="required" />
                      </xsd:complexType>
                    </xsd:element>
                    <xsd:element name="ChannelStrip" minOccurs="1">
                      <xsd:complexType>
                        <xsd:all>
                          <xsd:element name="Volume" type="ubyteType" minOccurs="1" />
                          <xsd:element name="Pan" type="ubyteType" minOccurs="1" />
                        </xsd:all>
                      </xsd:complexType>
                    </xsd:element>
                    <xsd:element name="PlaybackState" type="playbackStateType" minOccurs="1" />
                    <xsd:element name="Lyrics" minOccurs="0">
                      <xsd:complexType>
                        <xsd:sequence>
                          <xsd:element name="Line" minOccurs="0" maxOccurs="5">
                            <xsd:complexType>
                              <xsd:all>
                                <xsd:element name="Text" type="xsd:string" minOccurs="0" />
                                <xsd:element name="Offset" type="xsd:unsignedInt" minOccurs="0" />
                              </xsd:all>
                            </xsd:complexType>
                          </xsd:element>
                        </xsd:sequence>
                      </xsd:complexType>
                    </xsd:element>
                    <xsd:element name="Properties" type="propertyListType" minOccurs="0" />
                  </xsd:all>
                  <xsd:attribute name="id" type="xsd:integer" use="required" />
                </xsd:complexType>
              </xsd:element>
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>
        
        <!-- MasterBars -->
        <xsd:element name="MasterBars" minOccurs="1" maxOccurs="1">
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element name="MasterBar" minOccurs="1" maxOccurs="unbounded">
                <xsd:complexType>
                  <xsd:all>
                    <xsd:element name="Key">
                      <xsd:complexType>
                        <xsd:all>
                          <xsd:element name="AccidentalCount" type="keyAccidentalType" minOccurs="1" />
                          <xsd:element name="Mode" type="keyModeType" minOccurs="1" />
                        </xsd:all>
                      </xsd:complexType>
                    </xsd:element>
                    <xsd:element name="Time" type="timeUnitType" minOccurs="1" />
                    <xsd:element name="Repeat" minOccurs="0" maxOccurs="1">
                      <xsd:complexType>
                        <xsd:attribute name="start" type="xsd:boolean" use="optional" />
                        <xsd:attribute name="end" type="xsd:boolean" use="optional" />
                        <xsd:attribute name="count" type="xsd:unsignedInt" use="optional" />
                      </xsd:complexType>
                    </xsd:element>
                    <xsd:element name="TripletFeel" type="tripletFeelType" minOccurs="0" />
                    <xsd:element name="DoubleBar" minOccurs="0" />
                    <xsd:element name="Section" minOccurs="0" maxOccurs="1">
                      <xsd:complexType>
                        <xsd:all>
                          <xsd:element name="Color" type="colorType" maxOccurs="1" />
                          <xsd:element name="Text" type="xsd:string" minOccurs="1" />
                        </xsd:all>
                      </xsd:complexType>
                    </xsd:element>
                    <xsd:element name="AlternateEndings" type="nonEmptyUintListType" minOccurs="0" maxOccurs="1" />
                    <xsd:element name="Directions" minOccurs="0" maxOccurs="1">
                      <xsd:complexType>
                        <xsd:sequence minOccurs="1" maxOccurs="unbounded">
                          <xsd:choice>
                            <xsd:element name="Target" type="directionTargetType" />
                            <xsd:element name="Jump" type="directionJumpType" />
                          </xsd:choice>
                        </xsd:sequence>
                      </xsd:complexType>
                    </xsd:element>
                    <xsd:element name="Fermatas" type="fermataListType" minOccurs="0" maxOccurs="1" />
                    <xsd:element name="Elements" minOccurs="0" maxOccurs="1">
                      <xsd:complexType>
                        <xsd:sequence minOccurs="1" maxOccurs="unbounded">
                          <xsd:choice>
                            <xsd:element name="VolumeAutomation" type="automationType" />
                            <xsd:element name="TempoAutomation" type="automationType" />
                          </xsd:choice>
                        </xsd:sequence>
                      </xsd:complexType>
                    </xsd:element>
                    <xsd:element name="Bars" type="nonEmptyUintListType" minOccurs="1" maxOccurs="1" />
                    <xsd:element name="Attributes" type="coreAttributeListType" minOccurs="0" />
                  </xsd:all>
                </xsd:complexType>
              </xsd:element>
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>

        <!-- Bars -->
        <xsd:element name="Bars" minOccurs="1" maxOccurs="1">
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element name="Bar" minOccurs="1" maxOccurs="unbounded">
                <xsd:complexType>
                  <xsd:all>
                    <xsd:element name="SimileMark" minOccurs="0">
                      <xsd:complexType>
                        <xsd:all>
                          <xsd:element name="Type" type="simileMarkType" minOccurs="1" />
                          <xsd:element name="Position" type="xsd:unsignedInt" minOccurs="0" />
                        </xsd:all>
                      </xsd:complexType>
                    </xsd:element>
                    <xsd:element name="Voices" type="voiceListType" />
                  </xsd:all>
                  <xsd:attribute name="id" type="xsd:integer" use="required" />
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="Attributes" type="coreAttributeListType" minOccurs="0" />
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>

        <!-- Voices -->
        <xsd:element name="Voices" minOccurs="1" maxOccurs="1">
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element name="Voice" minOccurs="0" maxOccurs="unbounded">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="Beats" type="uintListType" />
                  </xsd:sequence>
                  <xsd:attribute name="id" type="xsd:integer" use="required" />
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="Attributes" type="coreAttributeListType" minOccurs="0" />
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>

        <!-- Beats -->
        <xsd:element name="Beats" minOccurs="1" maxOccurs="1">
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element name="Beat" minOccurs="0" maxOccurs="unbounded">
                <xsd:complexType>
                  <xsd:all>
                    <xsd:element name="Rhythm" minOccurs="0">
                      <xsd:complexType>
                        <xsd:attribute name="ref" type="xsd:unsignedInt" use="required" />
                      </xsd:complexType>
                    </xsd:element>
                    <xsd:element name="GraceNotes" type="graceNotesType" minOccurs="0" />
                    <xsd:element name="Dynamic" type="dynamicType" minOccurs="0" />
                    <xsd:element name="Ottavia" type="ottaviaType" minOccurs="0" />
                    <xsd:element name="Tremolo" type="timeUnitType" minOccurs="0" />
                    <xsd:element name="Arpeggio" minOccurs="0">
                      <xsd:complexType>
                        <xsd:all>
                          <xsd:element name="Direction" type="strokeDirectionType" minOccurs="1" />
                          <xsd:element name="Speed" type="timeUnitType" minOccurs="1" />
                        </xsd:all>
                      </xsd:complexType>
                    </xsd:element>
                    <xsd:element name="FadeIn" minOccurs="0" />
                    <xsd:element name="Slashed" minOccurs="0" />
                    <xsd:element name="FreeText" type="xsd:string" minOccurs="0" />
                    <xsd:element name="Notes" type="uintListType" minOccurs="0" />
                    <xsd:element name="Lyrics" minOccurs="0">
                      <xsd:complexType>
                        <xsd:sequence minOccurs="5" maxOccurs="5">
                          <xsd:element name="Line" type="xsd:string" />
                        </xsd:sequence>
                      </xsd:complexType>
                    </xsd:element>
                    <xsd:element name="Properties" type="propertyListType" minOccurs="0" />
                    <xsd:element name="Attributes" type="coreAttributeListType" minOccurs="0" />
                  </xsd:all>
                  <xsd:attribute name="id" type="xsd:unsignedInt" use="required" />
                </xsd:complexType>
              </xsd:element>
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>

        <!-- Notes -->
        <xsd:element name="Notes" minOccurs="1" maxOccurs="1">
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element name="Note" minOccurs="0" maxOccurs="unbounded">
                <xsd:complexType>
                  <xsd:all>
                    <xsd:element name="Duration" type="xsd:unsignedInt" minOccurs="0" />
                    <xsd:element name="LetRing" minOccurs="0" />
                    <xsd:element name="Tie" minOccurs="0">
                      <xsd:complexType>
                        <xsd:attribute name="origin" type="xsd:boolean" use="optional" />
                        <xsd:attribute name="destination" type="xsd:boolean" use="optional" />
                      </xsd:complexType>
                    </xsd:element>
                    <xsd:element name="Legato" type="legatoType"  minOccurs="0" />
                    <xsd:element name="Staccato" minOccurs="0" />
                    <xsd:element name="Accentuation" type="accentuationType" minOccurs="0" />
                    <xsd:element name="Ornament" minOccurs="0" />
                    <xsd:element name="DummyNote" minOccurs="0" />
                    <xsd:element name="Trill" minOccurs="0" maxOccurs="1">
                      <xsd:complexType>
                        <xsd:all>
                          <xsd:element name="Pitch" type="ubyteType" minOccurs="0"/>
                          <xsd:element name="Speed" type="timeUnitType" minOccurs="0"/>
                        </xsd:all>
                      </xsd:complexType>
                    </xsd:element>
                    <xsd:element name="LeftFingering" type="fingeringType" minOccurs="0" />
                    <xsd:element name="RightFingering" type="fingeringType" minOccurs="0" />
                    <xsd:element name="GraceNote" minOccurs="0">
                      <xsd:complexType>
                        <xsd:all>
                          <xsd:element name="OnBeat" minOccurs="0" />
                          <xsd:element name="Mute" minOccurs="0" />
                          <xsd:element name="Pitch" type="ubyteType" />
                          <xsd:element name="Transition" type="graceNoteTransitionType" minOccurs="0" />
                          <xsd:element name="Dynamic" type="dynamicType" />
                          <xsd:element name="Duration" type="timeUnitType" />
                        </xsd:all>
                      </xsd:complexType>
                    </xsd:element>
                    <xsd:element name="Properties" type="propertyListType" minOccurs="0" />
                  </xsd:all>
                  <xsd:attribute name="id" type="xsd:unsignedInt" use="required" />
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="Attributes" type="coreAttributeListType" minOccurs="0" />
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>

        <!-- Rhythms -->
        <xsd:element name="Rhythms">
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element name="Rhythm" minOccurs="0" maxOccurs="unbounded">
                <xsd:complexType>
                  <xsd:all>
                    <xsd:element name="NoteValue" type="noteValueType" minOccurs="0" />
                    <xsd:element name="AugmentationDot" minOccurs="0">
                      <xsd:complexType>
                        <xsd:attribute name="count" type="xsd:unsignedInt" use="optional" />
                      </xsd:complexType>
                    </xsd:element>
                    <xsd:element name="PrimaryTuplet" minOccurs="0">
                      <xsd:complexType>
                        <xsd:attribute name="num" type="xsd:unsignedInt" use="required" />
                        <xsd:attribute name="den" type="xsd:unsignedInt" use="required" />
                      </xsd:complexType>
                    </xsd:element>
                    <xsd:element name="SecondaryTuplet" minOccurs="0">
                      <xsd:complexType>
                        <xsd:attribute name="num" type="xsd:unsignedInt" use="required" />
                        <xsd:attribute name="den" type="xsd:unsignedInt" use="required" />
                      </xsd:complexType>
                    </xsd:element>
                  </xsd:all>
                  <xsd:attribute name="id" type="xsd:unsignedInt" use="required" />
                </xsd:complexType>
              </xsd:element>
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>

      </xsd:all>
    </xsd:complexType>
  </xsd:element>

</xsd:schema>
