      <!-- Guitars -->
      <xsd:enumeration value="e-gtr6" />
      <xsd:enumeration value="e-gtr7" />
      <xsd:enumeration value="e-gtr8" />
      <xsd:enumeration value="e-gtr12" />
      <xsd:enumeration value="n-gtr6" />
      <xsd:enumeration value="n-gtr7" />
      <xsd:enumeration value="n-gtr8" />
      <xsd:enumeration value="s-gtr6" />
      <xsd:enumeration value="s-gtr7" />
      <xsd:enumeration value="s-gtr8" />
      <xsd:enumeration value="s-gtr12" />
      <xsd:enumeration value="r-gtr6" />
      <xsd:enumeration value="m-gtr6" />
      <xsd:enumeration value="m-gtr7" />
      <xsd:enumeration value="m-gtr8" />
      <xsd:enumeration value="m-gtr12" />
      <xsd:enumeration value="bjn4" />
      <xsd:enumeration value="bjn5" />
      <xsd:enumeration value="bjn6" />
      <xsd:enumeration value="mndln8" />
      <xsd:enumeration value="ukll4" />
      <!-- Basses -->
      <xsd:enumeration value="e-bass4" />
      <xsd:enumeration value="e-bass5" />
      <xsd:enumeration value="e-bass6" />
      <xsd:enumeration value="a-bass4" />
