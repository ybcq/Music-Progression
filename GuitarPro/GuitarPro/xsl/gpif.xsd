      <xsd:enumeration value="a-piano" />
      <xsd:enumeration value="e-piano" />
      <xsd:enumeration value="em-organ" />
      <xsd:enumeration value="hrpch" />
      <!-- Synthetisers -->
      <xsd:enumeration value="snt-pad" />
      <xsd:enumeration value="snt-lead" />
      <xsd:enumeration value="snt-brass" />
      <xsd:enumeration value="snt-key" />
